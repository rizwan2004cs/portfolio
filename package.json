{
  "name": "rizwan-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npx tsx scripts/index-facts.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e next build && NEXT_DIST_DIR=.next-e2e playwright test",
    "eval:live": "node scripts/eval-live.mjs",
    "eval:intents": "node --env-file-if-exists=.env.local scripts/eval-intents.mjs",
    "eval:conversations": "node scripts/eval-conversations.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "resume": "node scripts/render-resume.mjs",
    "eval:deepeval": "cd evals && DEEPEVAL_TELEMETRY_OPT_OUT=YES .venv/bin/deepeval test run . && .venv/bin/python summarize.py"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@ag-ui/encoder": "1.0.3",
    "@neondatabase/serverless": "1.2.0",
    "@sentry/nextjs": "11.9.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.10.3",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.3",
    "opik": "2.2.121",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "schema-dts": "2.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
